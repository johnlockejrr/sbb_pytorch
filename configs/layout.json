{
    "task": "segmentation",
    "backbone_type": "transformer",
    "n_classes": 7,
    "input_height": 448,
    "input_width": 448,
    "light_model": false,
    "patches": false,
    "pretraining": true,
    "data_is_provided": false,

    "n_epochs": 50,
    "n_batch": 1,
    "learning_rate": 1e-4,
    "weight_decay": 1e-6,
    "optimizer": "adam",
    "momentum": 0.9,
    "device": "auto",
    "num_workers": 4,
    "patience": 10,
    "precision": "32-true",
    "continue_training": false,
    "index_start": 0,
    "dir_of_start_model": " ",
    "weighted_loss": false,
    "is_loss_soft_dice": false,

    "augmentation": true,
    "flip_aug": false,
    "blur_aug": false,
    "scaling": false,
    "adding_rgb_background": true,
    "adding_rgb_foreground": true,
    "add_red_textlines": false,
    "channels_shuffling": false,
    "degrading": false,
    "brightening": false,
    "binarization": true,
    "scaling_bluring": false,
    "scaling_binarization": false,
    "scaling_flip": false,
    "rotation": false,
    "rotation_not_90": false,
    "blur_k": ["blur", "gauss", "median"],
    "scales": [0.6, 0.7, 0.8, 0.9],
    "brightness": [1.3, 1.5, 1.7, 2.0],
    "degrade_scales": [0.2, 0.4],
    "flip_index": [0, 1, -1],
    "shuffle_indexes": [[0, 2, 1], [1, 2, 0], [1, 0, 2], [2, 1, 0]],
    "thetha": [5, -5],
    "number_of_backgrounds_per_image": 2,

    "transformer": {
        "num_patches_xy": [112, 112],
        "patchsize_x": 4,
        "patchsize_y": 4,
        "projection_dim": 64,
        "mlp_head_units": [128, 64],
        "layers": 1,
        "num_heads": 1,
        "cnn_first": false
    },

    "page2label": {
        "use_case": "layout",
        "textregions": {
            "rest_as_paragraph": 1,
            "header": 2,
            "heading": 2,
            "marginalia": 3
        },
        "imageregion": 4,
        "separatorregion": 5,
        "graphicregions": { "rest_as_decoration": 6 },
        "columns_width": { "1": 1000, "2": 1300, "3": 1600, "4": 2000, "5": 2300, "6": 2500 }
    },

    "dir_train": "data/layout/train",
    "dir_eval": "data/layout/eval",
    "dir_output": "runs/layout",
    "dir_rgb_backgrounds": "",
    "dir_rgb_foregrounds": "",
    "dir_img_bin": "",

    "type_output": "2d",
    "save_visualisation": true
}
