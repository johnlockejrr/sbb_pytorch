{
    "task": "enhancement",
    "backbone_type": "nontransformer",
    "n_classes": 3,
    "input_height": 448,
    "input_width": 448,
    "light_model": false,
    "patches": false,
    "pretraining": false,
    "data_is_provided": true,

    "n_epochs": 50,
    "n_batch": 2,
    "learning_rate": 1e-4,
    "weight_decay": 1e-6,
    "optimizer": "adam",
    "momentum": 0.9,
    "device": "auto",
    "num_workers": 4,
    "patience": 10,
    "precision": "32-true",
    "continue_training": false,
    "index_start": 0,
    "dir_of_start_model": " ",
    "weighted_loss": false,
    "is_loss_soft_dice": false,

    "augmentation": false,
    "flip_aug": false,
    "blur_aug": false,
    "scaling": false,
    "adding_rgb_background": false,
    "adding_rgb_foreground": false,
    "add_red_textlines": false,
    "channels_shuffling": false,
    "degrading": false,
    "brightening": false,
    "binarization": false,
    "scaling_bluring": false,
    "scaling_binarization": false,
    "scaling_flip": false,
    "rotation": false,
    "rotation_not_90": false,
    "blur_k": ["blur", "gauss", "median"],
    "scales": [0.6, 0.7, 0.8, 0.9],
    "brightness": [1.3, 1.5, 1.7, 2.0],
    "degrade_scales": [0.2, 0.4],
    "flip_index": [0, 1, -1],
    "shuffle_indexes": [[0, 2, 1], [1, 2, 0], [1, 0, 2], [2, 1, 0]],
    "thetha": [5, -5],
    "number_of_backgrounds_per_image": 2,

    "enhancement_scales": {
        "scales": [0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9]
    },

    "dir_train": "data/enhancement/train",
    "dir_eval": "data/enhancement/eval",
    "dir_output": "runs/enhancement",
    "dir_rgb_backgrounds": "",
    "dir_rgb_foregrounds": "",
    "dir_img_bin": "",

    "type_output": "2d",
    "save_visualisation": true
}
