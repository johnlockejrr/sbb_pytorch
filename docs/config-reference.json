    "accumulate_grad_batches": {
      "default": 1,
      "minimum": 1,
      "title": "Accumulate Grad Batches",
      "type": "integer"
    },
    "add_red_textlines": {
      "default": false,
      "title": "Add Red Textlines",
      "type": "boolean"
    },
    "adding_rgb_background": {
      "default": false,
      "title": "Adding Rgb Background",
      "type": "boolean"
    },
    "adding_rgb_foreground": {
      "default": false,
      "title": "Adding Rgb Foreground",
      "type": "boolean"
    },
    "augmentation": {
      "default": false,
